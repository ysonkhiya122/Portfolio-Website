{
  "name": "yash-sonkhiya-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Product-grade personal engineering site: case studies, impact metrics, and a typed content layer.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-pages.mjs && npm run build:cv && tsc -b && vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:a11y": "jest --selectProjects a11y",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-budget.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "validate": "npm run validate:content && npm run validate:links && npm run validate:cv && npm run lint && npm run format:check && npm run test && npm run build && npm run size",
    "validate:content": "node scripts/validate-content.mjs",
    "visual": "node scripts/visual-check.mjs",
    "build:cv": "node scripts/build-cv.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:cv": "node scripts/validate-cv.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^16.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "zod": "^4.6.7"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "not dead"
  ],
  "overrides": {
    "handlebars": "^4.7.10",
    "source-map-js": "^1.2.4",
    "js-yaml": "^4.3.2",
    "brace-expansion": "^2.0.2",
    "glob": "^11.0.3"
  }
}
